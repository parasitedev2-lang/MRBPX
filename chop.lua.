})

-- Глобальные настройки управления
_G.AutoTrees = false
_G.AutoGems = false
_G.AutoCandy = false
_G.AutoNPC = false
_G.TweenSpeed = 50

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- Кроссплатформенная функция плавной левитации/телепорта
local function teleportTo(targetCFrame)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        local distance = (rootPart.Position - targetCFrame.Position).Magnitude
        local duration = distance / _G.TweenSpeed
        
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end
end

-- Оптимизированный кликер (Поддерживает ПК-клики и Xeno Tool-активацию)
local function hitTarget()
    -- Способ 1: Прямая активация инструмента в руках (самый надежный способ для Xeno)
    local character = LocalPlayer.Character
    local tool = character and character:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
    
    -- Способ 2: Симуляция клика мыши (для ПК-версий эксплойтов)
    if mouse1click then
        mouse1click()
    else
        -- Запасной способ для мобильных инжекторов
        local virtualUser = game:GetService("VirtualUser")
        virtualUser:CaptureController()
        virtualUser:ClickButton1(Vector2.new(0, 0))
    end
end

