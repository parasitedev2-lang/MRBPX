-- ================= ЛОГИКА ФАРМА (ПОТОК) =================

task.spawn(function()
    while task.wait(0.2) do
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("Humanoid") then continue end
        
        -- Сбор предметов (Candy Corn / Gems)
        if _G.AutoGems or _G.AutoCandy then
            for _, item in ipairs(workspace:GetChildren()) do
                if (_G.AutoCandy and item.Name == "CandyCorn") or (_G.AutoGems and item.Name == "Gem") then
                    local part = item:FindFirstChildWhichIsA("BasePart")
                    if part then
                        teleportTo(part.CFrame)
                        task.wait(0.1)
                        if not (_G.AutoGems or _G.AutoCandy) then break end
                    end
                end
            end
        end
        
        -- Фарм деревьев
        if _G.AutoTrees then
            for _, tree in ipairs(workspace:GetChildren()) do
                if tree.Name == "Tree" and tree:FindFirstChild("Trunk") then
                    local health = tree:FindFirstChild("Health")
                    if health and health.Value <= 0 then continue end
                    
                    -- Летим к дереву
                    teleportTo(tree.Trunk.CFrame * CFrame.new(0, 0, 3))
                    
                    -- Бьем, пока дерево не сломается
                    while _G.AutoTrees and (not health or health.Value > 0) and tree:FindFirstChild("Trunk") do
                        hitTarget()
                        task.wait(0.15)
                    end
                end
            end
        end

        -- Убийство всех NPC на карте
        if _G.AutoNPC then
            for _, npc in ipairs(workspace:GetChildren()) do
                if npc:FindFirstChild("Humanoid") and npc:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(npc) then
                    local humanoid = npc.Humanoid
                    local root = npc.HumanoidRootPart
                    
                    if humanoid.Health > 0 then
                        -- Безопасная позиция: зависаем ровно НАД головой NPC, чтобы он не мог попасть по нам
                        while _G.AutoNPC and humanoid.Health > 0 and root do
                            teleportTo(root.CFrame * CFrame.new(0, 5.5, 0))
                            hitTarget()
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
    end
end)
